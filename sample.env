# ____REMOVE THIS LINE AFTER RENAMING sample.env to .env ____

# Connection method: DARKX MD connects using a Pairing Code generated from
# the built-in pairing website (open http://localhost:PORT/pair once the
# bot is running, type your WhatsApp number, and enter the code shown).
# SESSION_ID below is no longer required for a fresh connection.

# (Optional / legacy) Restore a previously saved session instead of pairing
SESSION_ID=

# Custom pairing code shown on the DARKX MD pairing website (8 characters)
CUSTOM_PAIRING_CODE=DARKXXMD

# (Optional) Pre-fill a number to auto-pair on startup without using the website
PAIRING_NUMBER=

# PUT YOUR REMOVE BACKGROUND KEY (Optional)
REMOVEBG_KEY=

PORT=5000

# Use One Of Following:
# Database Configuration (Optional but recommended)
# Leave empty to use JSON file storage

# MongoDB (Optional)
MONGO_URL=

# PostgreSQL (Optional)
POSTGRES_URL=

# MySQL (Optional)
MYSQL_URL=

# SQLite Path (Optional)
# Example: DB_URL=./data/baileys.db
DB_URL=

PREFIXES=.,!,/

PACKNAME=DARKX MD

BOT_NAME=DARKX MD

OWNER_NUMBER=923000000000

COMMAND_MODE=private

BOT_OWNER=DARKX-MD

TIMEZONE=Asia/Karachi
